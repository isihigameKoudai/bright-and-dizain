---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  src: ImageMetadata
  class?: string
}
const { src, class: className = '' } = Astro.props
---

<div class:list={['img-circle', className]}>
  <Image
    src={src}
    format="webp"
    widths={[200, 400]}
    sizes="200px"
    alt=""
    loading="lazy"
    decoding="async"
  />
</div>
