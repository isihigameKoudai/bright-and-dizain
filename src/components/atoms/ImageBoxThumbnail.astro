---
import { Picture, getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  src: ImageMetadata
  lrg: ImageMetadata
  alt?: string
}
const { src, lrg, alt = 'image' } = Astro.props
const lrgOptimized = await getImage({ src: lrg, format: 'webp', width: 1600 })
---

<figure>
  <Picture
    src={src}
    formats={['avif', 'webp']}
    widths={[300, 600]}
    sizes="(max-width: 768px) 33vw, 300px"
    alt={alt}
    loading="lazy"
    decoding="async"
    class="image"
    data-lrg={lrgOptimized.src}
  />
</figure>
