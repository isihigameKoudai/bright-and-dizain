---
import Layout from '../layouts/Layout.astro'
import LabelNormal from '../components/atoms/LabelNormal.astro'
---

<Layout>
  <div id="error">
    <div class="error-container">
      <h1 class="error-code">404</h1>
      <LabelNormal class="taC mt10">指定されたページは存在しません。</LabelNormal>
      <LabelNormal class="taC mt10">
        <a href="/" class="link">TOPへ戻る</a>
      </LabelNormal>
    </div>
  </div>
</Layout>
